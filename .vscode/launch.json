{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "NEMBA: GUI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "NEMBA: demo (CLI, fast)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--demo", "--backbone", "tcn", "--speed", "fast", "--out", "${workspaceFolder}/embedder_out/demo"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "NEMBA: benchmark v0.1 vs v0.2",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/benchmarks/benchmark_v01_vs_v02.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "NEMBA: tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q", "tests"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        }
    ]
}
